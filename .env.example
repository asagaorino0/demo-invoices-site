# Optional PostgreSQL workbench settings
# DB を使う場合だけ設定します。Google Sheets を正本にする運用では必須ではありません。
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/konoyubi_invoices?sslmode=require
POSTGRES_DB_NAME=konoyubi_invoices
POSTGRES_SSL_MODE=require

# Google Sheets sync settings
# `.env.local` にはサービスアカウント認証情報と、任意で Google OAuth クライアント情報を入れます。
# 利用者ごとのスプレッドシート URL / ID とシート名は `/projects` 画面から保存します。
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
